{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LarysaK/AI-QA-AutomationFramework/reporting/ci/history-index.schema.json",
  "title": "CI history index v1.0",
  "description": "The index of the CI execution history (v1/index.json): one entry per recorded run attempt, rebuilt deterministically from the immutable records in v1/runs and ordered by job completion time, run ID and attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "recordSchema", "runs"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "ci-history-index" },
    "recordSchema": { "const": "ci-run/1.0" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runId",
          "attempt",
          "number",
          "commitSha",
          "event",
          "conclusion",
          "jobCompletedAt",
          "path",
          "sha256"
        ],
        "properties": {
          "runId": { "type": "integer", "minimum": 1 },
          "attempt": { "type": "integer", "minimum": 1 },
          "number": { "type": "integer", "minimum": 1 },
          "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "event": { "enum": ["push", "workflow_dispatch"] },
          "conclusion": { "enum": ["success", "failure", "cancelled", "timed_out"] },
          "jobCompletedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          },
          "path": { "type": "string", "pattern": "^v1/runs/[1-9][0-9]*-[1-9][0-9]*\\.json$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
