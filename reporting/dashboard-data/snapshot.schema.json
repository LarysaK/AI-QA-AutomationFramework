{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LarysaK/AI-QA-AutomationFramework/reporting/dashboard-data/snapshot.schema.json",
  "title": "QA Dashboard data snapshot v1",
  "description": "Public dashboard data derived from the approved requirements, the approved test plan and the committed Playwright tests. Automation intent (plan), automation linkage (committed tests) and execution results (CI) are separate concepts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "app",
    "source",
    "requirements",
    "testCases",
    "canonicals",
    "testInstances",
    "execution",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "app": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "documents", "discovery"],
      "properties": {
        "commit": {
          "description": "The commit whose specs/ and tests/ the snapshot was built from; both must be unmodified.",
          "$ref": "#/$defs/sha1"
        },
        "documents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "title", "gitBlobSha"],
            "properties": {
              "path": { "$ref": "#/$defs/specPath" },
              "title": { "$ref": "#/$defs/text" },
              "gitBlobSha": { "$ref": "#/$defs/sha1" }
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "testDir", "playwrightVersion"],
          "properties": {
            "method": { "const": "playwright test --list --reporter=json" },
            "testDir": { "const": "tests" },
            "playwrightVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "markdown", "automationLinkage"],
        "properties": {
          "id": { "$ref": "#/$defs/reqId" },
          "title": { "$ref": "#/$defs/text" },
          "markdown": {
            "description": "The requirement section, verbatim.",
            "type": "string",
            "minLength": 1
          },
          "automationLinkage": { "$ref": "#/$defs/linkage" }
        }
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirementId",
          "scenario",
          "level",
          "type",
          "priority",
          "automationIntent",
          "automationLinkage"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/tcId" },
          "requirementId": { "$ref": "#/$defs/reqId" },
          "scenario": {
            "description": "The plan's Scenario cell, verbatim.",
            "$ref": "#/$defs/text"
          },
          "level": { "$ref": "#/$defs/level" },
          "type": { "$ref": "#/$defs/text" },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "automationIntent": {
            "description": "The plan's Automation column: whether the scenario is intended for automation. Not linkage, not execution.",
            "enum": ["Yes", "No"]
          },
          "automationLinkage": { "$ref": "#/$defs/linkage" }
        }
      }
    },
    "canonicals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "level", "covers", "automationLinkage"],
        "properties": {
          "id": { "$ref": "#/$defs/canId" },
          "title": { "$ref": "#/$defs/text" },
          "level": { "$ref": "#/$defs/level" },
          "covers": { "description": "The plan's Covers cell, verbatim.", "$ref": "#/$defs/text" },
          "automationLinkage": { "$ref": "#/$defs/linkage" }
        }
      }
    },
    "testInstances": {
      "description": "Committed Playwright specs, as discovered by Playwright. One entry per spec; projects lists where it runs.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "line", "title", "describePath", "projects", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-f]+-[0-9a-f]+$" },
          "file": {
            "type": "string",
            "pattern": "^tests/[A-Za-z0-9._/-]+\\.(spec|test)\\.[cm]?[jt]sx?$"
          },
          "line": { "type": "integer", "minimum": 1 },
          "title": { "$ref": "#/$defs/text" },
          "describePath": { "type": "array", "items": { "$ref": "#/$defs/text" } },
          "projects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/text" }
          },
          "tags": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirements", "testCases", "canonicals"],
            "properties": {
              "requirements": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/reqId" }
              },
              "testCases": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/tcId" }
              },
              "canonicals": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/canId" }
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci", "localResults"],
      "properties": {
        "ci": {
          "description": "Execution history from CI. Schema v1.0 has no CI integration, so no run can be recorded.",
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "runs"],
          "properties": {
            "status": { "const": "no-ci-runs" },
            "runs": { "type": "array", "maxItems": 0 }
          }
        },
        "localResults": {
          "description": "Local Playwright results are never read and never presented as execution history.",
          "const": "not-used"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "testCases",
        "testCasesByLevel",
        "testCasesByPriority",
        "testCasesByAutomationIntent",
        "canonicals",
        "testInstances",
        "linkedTestCases",
        "linkedTestCasesWithIntentYes"
      ],
      "properties": {
        "requirements": { "$ref": "#/$defs/count" },
        "testCases": { "$ref": "#/$defs/count" },
        "testCasesByLevel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["API", "UI", "E2E"],
          "properties": {
            "API": { "$ref": "#/$defs/count" },
            "UI": { "$ref": "#/$defs/count" },
            "E2E": { "$ref": "#/$defs/count" }
          }
        },
        "testCasesByPriority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["P0", "P1", "P2"],
          "properties": {
            "P0": { "$ref": "#/$defs/count" },
            "P1": { "$ref": "#/$defs/count" },
            "P2": { "$ref": "#/$defs/count" }
          }
        },
        "testCasesByAutomationIntent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Yes", "No"],
          "properties": {
            "Yes": { "$ref": "#/$defs/count" },
            "No": { "$ref": "#/$defs/count" }
          }
        },
        "canonicals": { "$ref": "#/$defs/count" },
        "testInstances": { "$ref": "#/$defs/count" },
        "linkedTestCases": {
          "description": "Test cases tagged on at least one committed test instance. Linkage, not proof that every data row is covered, and not an execution result.",
          "$ref": "#/$defs/count"
        },
        "linkedTestCasesWithIntentYes": { "$ref": "#/$defs/count" }
      }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reqId": { "type": "string", "pattern": "^REQ-\\d{3}$" },
    "tcId": { "type": "string", "pattern": "^TC-\\d{3}-\\d{2}$" },
    "canId": { "type": "string", "pattern": "^CAN-\\d{3}$" },
    "level": { "enum": ["API", "UI", "E2E"] },
    "count": { "type": "integer", "minimum": 0 },
    "text": { "type": "string", "minLength": 1 },
    "specPath": {
      "type": "string",
      "pattern": "^specs/[a-z0-9][a-z0-9-]*/(requirements|test-plan)\\.md$"
    },
    "linkage": {
      "description": "Committed test instances tagged with this ID. Derived from committed tests only; staged proposals never count.",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "testInstanceIds"],
      "properties": {
        "status": { "enum": ["linked", "not-linked"] },
        "testInstanceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]+-[0-9a-f]+$" }
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": { "const": "linked" },
            "testInstanceIds": { "type": "array", "minItems": 1 }
          }
        },
        {
          "type": "object",
          "properties": {
            "status": { "const": "not-linked" },
            "testInstanceIds": { "type": "array", "maxItems": 0 }
          }
        }
      ]
    }
  }
}
