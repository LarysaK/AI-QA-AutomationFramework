{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents/standard/envelope.schema.json",
  "title": "Agent artifact envelope",
  "description": "Common envelope for every agent artifact (Agent Standard v2.0, section 9: Artifact envelope). Agent-specific content goes in `payload` and is validated by that agent's own schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactType",
    "schemaVersion",
    "standardVersion",
    "agent",
    "taskId",
    "status",
    "summary",
    "sourceReferences",
    "traceability",
    "assumptions",
    "findings",
    "proposedChanges",
    "payload"
  ],
  "properties": {
    "artifactType": {
      "enum": ["test-plan-proposal", "test-proposal", "heal-proposal"]
    },
    "schemaVersion": {
      "description": "Envelope schema version. This schema accepts major version 2.",
      "type": "string",
      "pattern": "^2\\.\\d+$"
    },
    "standardVersion": {
      "description": "Agent Standard version the agent followed. This schema accepts major version 2.",
      "type": "string",
      "pattern": "^2\\.\\d+$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "definitionVersion"],
      "properties": {
        "name": {
          "description": "The three agents of Agent Standard 2.0 (section 2.1). The Validator is not an agent.",
          "enum": ["planner", "generator", "healer"]
        },
        "definitionVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        }
      }
    },
    "taskId": {
      "description": "Assigned by the orchestrator; used as the staging directory name.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "description": "Agent artifact status (standard section 7.1). Orchestrator pipeline statuses are never part of the artifact.",
      "enum": ["READY", "BLOCKED", "NEEDS_HUMAN_DECISION"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceReference"
      }
    },
    "traceability": {
      "$ref": "#/$defs/traceability"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "contextRequests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposedChanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposedChange"
      }
    },
    "payload": {
      "description": "Agent-specific content, validated by the agent's payload schema.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "description": "BLOCKED requires at least one context request (STD-CTX-003).",
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "contextRequests": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": ["contextRequests"]
      }
    },
    {
      "description": "NEEDS_HUMAN_DECISION requires at least one finding stating the decision needed.",
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "NEEDS_HUMAN_DECISION"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "description": "Each artifact type is produced by exactly one agent.",
      "if": {
        "type": "object",
        "properties": {
          "artifactType": {
            "const": "test-plan-proposal"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "name": {
                "const": "planner"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "artifactType": {
            "const": "test-proposal"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "name": {
                "const": "generator"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "artifactType": {
            "const": "heal-proposal"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "name": {
                "const": "healer"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-\\d{3}$"
    },
    "testCaseId": {
      "type": "string",
      "pattern": "^TC-\\d{3}-\\d{2}$"
    },
    "canonicalId": {
      "type": "string",
      "pattern": "^CAN-\\d{3}$"
    },
    "ruleId": {
      "description": "Standard rule (STD-AREA-NNN) or agent rule (PLN/GEN/HEA-NNN). The ANA- prefix of Standard 1.x is retired.",
      "type": "string",
      "pattern": "^(STD-(SRC|CTX|TRC|AUTH|ART|UNC|CAN|TST|SEC)|PLN|GEN|HEA)-\\d{3}$"
    },
    "approvedId": {
      "anyOf": [
        {
          "$ref": "#/$defs/requirementId"
        },
        {
          "$ref": "#/$defs/testCaseId"
        },
        {
          "$ref": "#/$defs/canonicalId"
        }
      ]
    },
    "repoPath": {
      "description": "Repository-relative POSIX path; no absolute paths, backslashes or '..' segments.",
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!(.*/)?\\.\\.(/|$)).+$"
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "role": {
          "enum": [
            "requirements",
            "test-plan",
            "canonical-test",
            "support",
            "test",
            "configuration",
            "architecture",
            "app-evidence",
            "run-evidence"
          ]
        },
        "ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approvedId"
          },
          "uniqueItems": true
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "testCases"],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirementId"
          },
          "uniqueItems": true
        },
        "testCases": {
          "description": "Approved TC IDs only. Provisional TC IDs belong in the Planner payload (STD-TRC-001).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/testCaseId"
          },
          "uniqueItems": true
        },
        "canonicalPatterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalId"
          },
          "uniqueItems": true
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "impact"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A-\\d{3}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "severity", "message"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-\\d{3}$"
        },
        "kind": {
          "enum": [
            "conflict",
            "ambiguity",
            "gap",
            "missing-context",
            "defect-candidate",
            "deviation",
            "novel-pattern",
            "risk"
          ]
        },
        "severity": {
          "enum": ["info", "warning", "blocking"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repoPath"
          },
          "uniqueItems": true
        },
        "ruleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleId"
          },
          "uniqueItems": true
        }
      }
    },
    "proposedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "changeKind", "operation", "content", "rationale", "traceability"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repoPath"
        },
        "changeKind": {
          "enum": ["test-change", "support-change", "plan-change"]
        },
        "operation": {
          "enum": ["create", "modify"]
        },
        "baseSha": {
          "description": "Git blob SHA of the file the change was written against (SHA-1 or SHA-256).",
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "content": {
          "description": "Full file content after the change, not a diff.",
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "traceability": {
          "$ref": "#/$defs/traceability"
        },
        "impact": {
          "description": "Required for support-change: why shared support must change and what existing tests or support it may affect (STD-ART-002).",
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "operation": {
                "const": "modify"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["baseSha"]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "operation": {
                "const": "create"
              }
            }
          },
          "then": {
            "type": "object",
            "not": {
              "required": ["baseSha"]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "changeKind": {
                "const": "support-change"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["impact"]
          }
        }
      ]
    }
  }
}
