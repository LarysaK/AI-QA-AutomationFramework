{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents/definitions/healer/healer-payload.schema.json",
  "title": "Healer payload",
  "description": "The payload of a heal-proposal artifact (Healer definition 1.0). Validated by G-SCHEMA together with the envelope. A diagnosis is a report; a repair is a healing patch that needs validation and human approval (H3), and its execution-capable validation needs H7.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelCall",
    "requestedModel",
    "servedModel",
    "effort",
    "maxTokens",
    "definitionVersion",
    "failure",
    "evidence",
    "diagnosis",
    "repair"
  ],
  "$defs": {
    "classification": {
      "enum": [
        "test-code-issue",
        "application-defect",
        "environment-or-infrastructure",
        "test-data-or-setup",
        "insufficient-evidence"
      ]
    },
    "evidenceId": { "type": "string", "pattern": "^E-\\d{3}$" },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/evidenceId" }
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "texts": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/text" } }
  },
  "properties": {
    "modelCall": { "enum": ["anthropic-api", "offline-recorded-output"] },
    "requestedModel": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "servedModel": { "type": "string", "minLength": 1, "maxLength": 200 },
    "effort": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "maxTokens": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
    "definitionVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportName",
        "reportSha256",
        "playwrightVersion",
        "specId",
        "testFile",
        "title",
        "line",
        "project",
        "attempts",
        "startedAt"
      ],
      "properties": {
        "reportName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "playwrightVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "specId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "testFile": { "type": "string", "pattern": "^tests/(?!.*\\.\\.).+\\.(spec|test)\\.ts$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "line": { "type": "integer", "minimum": 1 },
        "project": { "type": "string", "minLength": 1, "maxLength": 100 },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "enum": ["passed", "failed", "timedOut", "interrupted", "skipped"] }
        },
        "startedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "sha256"],
        "properties": {
          "id": { "$ref": "#/$defs/evidenceId" },
          "kind": {
            "enum": [
              "error-message",
              "stack",
              "expected-actual",
              "steps",
              "attempts",
              "environment",
              "test-source",
              "support-source"
            ]
          },
          "source": { "type": "string", "minLength": 1, "maxLength": 300 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "explanation",
        "evidenceRefs",
        "confidence",
        "alternatives",
        "missingEvidence",
        "recommendedInvestigation"
      ],
      "properties": {
        "classification": { "$ref": "#/$defs/classification" },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "alternatives": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["classification", "explanation", "evidenceRefs"],
            "properties": {
              "classification": { "$ref": "#/$defs/classification" },
              "explanation": { "$ref": "#/$defs/text" },
              "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
            }
          }
        },
        "missingEvidence": { "$ref": "#/$defs/texts" },
        "recommendedInvestigation": { "$ref": "#/$defs/texts" }
      }
    },
    "repair": {
      "description": "null for a diagnosis only. A repair is never applied by the Healer and is not approved: humanReview is always required, at gate H3.",
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedBehaviorPreserved",
            "risks",
            "validationSteps",
            "humanReview",
            "reviewGate"
          ],
          "properties": {
            "expectedBehaviorPreserved": { "$ref": "#/$defs/text" },
            "risks": { "$ref": "#/$defs/texts" },
            "validationSteps": { "$ref": "#/$defs/texts" },
            "humanReview": { "const": "required" },
            "reviewGate": { "const": "H3" }
          }
        }
      ]
    }
  }
}
