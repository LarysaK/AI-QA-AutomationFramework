{
  "name": "ai-qa-automation",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted QA automation framework built on TypeScript and Playwright. AI agents operate outside the deterministic test runtime.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "aut:start": "tsx apps/requestflow/app/src/main.ts",
    "agents:validate": "tsx agents/orchestrator/validation/cli.ts",
    "agents:test": "tsx --test agents/orchestrator/validation/validate.test.ts agents/orchestrator/validation/trace-guard.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "dotenv": "^17.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-playwright": "^2.2.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  }
}
